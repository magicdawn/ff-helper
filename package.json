{
  "name": "ff-helper",
  "type": "module",
  "version": "0.7.0",
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "description": "ffmpeg helper by napi-rs binding",
  "author": "magicdawn",
  "license": "MIT",
  "homepage": "https://github.com/magicdawn/ff-helper#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/magicdawn/ff-helper.git"
  },
  "bugs": {
    "url": "https://github.com/magicdawn/ff-helper/issues"
  },
  "keywords": [
    "ffmpeg",
    "ffprobe",
    "napi",
    "napi-rs",
    "video-info",
    "video-rotation",
    "video-duration"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "./ff-helper.*.node",
    "CHANGELOG.md",
    "Cargo.lock",
    "Cargo.toml",
    "LICENSE",
    "README.md",
    "addon.d.ts",
    "addon.js",
    "build.rs",
    "lib",
    "package.json",
    "src"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepare": "husky",
    "build:debug": "napi build --platform --esm --js addon.js --dts addon.d.ts",
    "build:release": "napi build --platform --esm --js addon.js --dts addon.d.ts --release --strip",
    "dev": "pnpm build:debug",
    "build:tsc": "rm -rf lib; tsc",
    "build": "pnpm build:release && pnpm test && pnpm build:tsc",
    "prepublishOnly": "pnpm build",
    "install": "pnpm build-addon-when-necessary",
    "build-addon-when-necessary": "(node ./addon.js > /dev/null 2>&1) || pnpm build:release",
    "test": "vitest run",
    "test-cover": "vitest run --coverage",
    "_prepublishOnly": "napi prepublish -t npm",
    "_artifacts": "napi artifacts",
    "_universal": "napi universal",
    "_version": "napi version"
  },
  "dependencies": {
    "@napi-rs/cli": "^3.8.5",
    "dayjs": "^1.11.21"
  },
  "devDependencies": {
    "@magicdawn/eslint-config": "^1.6.17",
    "@magicdawn/prettier-config": "^0.1.0",
    "@swc/core": "^1.15.47",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "4.1.10",
    "dl-vampire": "^2.1.7",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "fs-extra": "^11.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "napi": {
    "binaryName": "ff-helper",
    "package": {},
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl"
    ]
  },
  "lint-staged": {
    "*.{?(c|m)(j|t)s?(x),json,y?(a)ml}": [
      "eslint --fix",
      "prettier --write"
    ],
    "!*.{?(c|m)(j|t)s?(x),json,y?(a)ml}": [
      "prettier --write --ignore-unknown"
    ]
  }
}
