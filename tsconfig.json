{
  "include": ["ts-src/**/*"],
  "compilerOptions": {
    "rootDir": "ts-src",
    "outDir": "lib",
    "target": "ES2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "types": ["node"],
    "resolveJsonModule": true,
    "declaration": true
  }
}
